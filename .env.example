# Configuración de ATLAS. Copia este fichero a `.env` y rellena tus datos.
#
# Los datos del club viven en PostgreSQL. Con Supabase, copia la cadena de
# conexión del panel del proyecto (Connect → Connection string → URI) y pégala
# en DATABASE_URL. La del *pooler* (puerto 6543) es la recomendada para una web.

# --- Base de datos (Supabase / PostgreSQL) ---------------------------------
# Opción A — Supabase u otro PostgreSQL en la nube (recomendado en producción):
DATABASE_URL=postgresql://postgres.TU_REF:TU_CLAVE@aws-0-TU_REGION.pooler.supabase.com:6543/postgres

# Opción B — Cluster local de desarrollo. Vive en /workspace/pgdata (volumen
# persistente, así que sobrevive a los reinicios del contenedor). Lo levanta
# ./scripts/setup-postgres.sh o ./atlas.sh start.
# DATABASE_URL=postgresql://atlas:atlas-dev-pass@127.0.0.1:5432/atlas
# ATLAS_TEST_DATABASE_URL=postgresql://atlas:atlas-dev-pass@127.0.0.1:5432/atlas_test

# Alternativa sin cadena de conexión (variables estándar de PostgreSQL):
# PGHOST=db.TU_REF.supabase.co
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=TU_CLAVE
# PGDATABASE=postgres

# Fuerza TLS aunque la cadena no lo pida. Supabase lo exige.
# ATLAS_DB_SSL=1

# Número máximo de conexiones del pool. En Supabase conviene no pasarse.
# ATLAS_DB_POOL=5

# --- Servidor --------------------------------------------------------------
PORT=12000
# HOST=0.0.0.0

# Secreto de las cookies de sesión. Si no se define, se guarda uno en la base de
# datos, de modo que reiniciar el servidor no expulsa a nadie.
# SESSION_SECRET=cadena-larga-y-aleatoria

# Cuenta de administrador. Solo se usa la primera vez, al crear la plantilla.
# ATLAS_ADMIN_USER=admin
# ATLAS_ADMIN_PASSWORD=atlas-admin

# Zona horaria para el "día de hoy" del club.
# ATLAS_TZ=Europe/Madrid
